FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598 AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/infra/package.json packages/infra/package.json
RUN bun install --frozen-lockfile --ignore-scripts --production --filter=ishigama-search

COPY scripts/recipes.ts scripts/recipes.ts
COPY packages/api/src/recipes.ts packages/api/src/recipes.ts
RUN bun build scripts/recipes.ts --target=bun --outfile=/app/recipes.js

FROM oven/bun:1.4.3-slim@sha256:14a223fa35747ec728bce300ef85888bc5f7958164d15bbba6a54b22b52a3288 AS runtime
WORKDIR /app
COPY --from=builder --chown=bun:bun /app/recipes.js ./recipes.js
USER root
RUN mkdir -p /app/data && chown bun:bun /app/data
USER bun
VOLUME ["/app/data"]
ENTRYPOINT ["bun", "/app/recipes.js"]
CMD ["scrape"]
