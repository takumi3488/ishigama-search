FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/infra/package.json packages/infra/package.json
RUN bun install --frozen-lockfile --ignore-scripts --production --filter=ishigama-search

COPY scripts/recipes.ts scripts/recipes.ts
COPY packages/api/src/recipes.ts packages/api/src/recipes.ts
RUN bun build scripts/recipes.ts --target=bun --outfile=/app/recipes.js

FROM oven/bun:1.4.4-slim@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4 AS runtime
WORKDIR /app
COPY --from=builder --chown=bun:bun /app/recipes.js ./recipes.js
USER root
RUN mkdir -p /app/data && chown bun:bun /app/data
USER bun
VOLUME ["/app/data"]
ENTRYPOINT ["bun", "/app/recipes.js"]
CMD ["scrape"]
