FROM oven/bun:1.4.5@sha256:3aa040e5445efa09d75bb428a64ba50db13e2b3ac9b6b0c7f145615f62b2ee18 AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/infra/package.json packages/infra/package.json
RUN bun install --frozen-lockfile --ignore-scripts --production --filter=ishigama-search

COPY scripts/recipes.ts scripts/recipes.ts
COPY packages/api/src/recipes.ts packages/api/src/recipes.ts
RUN bun build scripts/recipes.ts --target=bun --outfile=/app/recipes.js

FROM oven/bun:1.4.5-slim@sha256:b780593f3e10918cbdaec3d5a08d52224b9198069a65eb47812085c2ec007643 AS runtime
WORKDIR /app
COPY --from=builder --chown=bun:bun /app/recipes.js ./recipes.js
USER root
RUN mkdir -p /app/data && chown bun:bun /app/data
USER bun
VOLUME ["/app/data"]
ENTRYPOINT ["bun", "/app/recipes.js"]
CMD ["scrape"]
