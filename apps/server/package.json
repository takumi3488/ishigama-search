{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@ishigama-search/api": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@hono/cli": "next",
    "@ishigama-search/config": "workspace:*",
    "@ishigama-search/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "wrangler": "4.148.0"
  }
}
